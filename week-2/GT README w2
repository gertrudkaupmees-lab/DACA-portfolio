--Grupitöö roll C Tooteandmete puhastamine
-- Ülesanne Leia duplikaadid, NULL väärtused ja ebajärjekindlused products tabelis. Loo test koopia ja dokumenteeri probleemid

--Samm 1. test koopia: Ridu 362.
DROP TABLE IF EXISTS products_test;
CREATE TABLE products_test AS SELECT * FROM products;
SELECT COUNT(*) AS ridade_arv FROM products_test;

--Samm 2. Leia duplikaadid — kas on korduvaid tootenimesid? 12 tk, sh 
SELECT product_name, COUNT(*) AS koopiate_arv
FROM products_test
GROUP BY product_name
HAVING COUNT(*) > 1
ORDER BY koopiate_arv DESC;

--duplikaatsed tootenimed:  NULL sisendiga andmeid ei leidu kriitilistes väljades.
SELECT
    COUNT(*) FILTER (WHERE product_name IS NULL OR product_name = '') AS null_nimi,
    COUNT(*) FILTER (WHERE category IS NULL OR category = '') AS null_kategooria,
    COUNT(*) FILTER (WHERE retail_price IS NULL) AS null_jaehind,
    COUNT(*) FILTER (WHERE cost_price IS NULL) AS null_omahind
FROM products_test;

-- Kas on negatiivseid hindu? ei ole
SELECT COUNT(*) AS negatiivne_hind
FROM products_test
WHERE retail_price < 0;

-- Kas on äärmuslikke hindu (> 1000€)? ei ole
SELECT product_name, retail_price
FROM products_test
WHERE retail_price > 1000
ORDER BY retail_price DESC;

-- Kontrolli kategooriate järjekindlust
SELECT category, COUNT(*) AS arv
FROM products_test
GROUP BY category
ORDER BY category;

--kas mõni kategooria esineb mitmes kirjapildis või tähesuuruses? Vastus võib olla, et ei esine - puhas veerg on leid, mitte ebaõnnestunud päring. Kirjuta üles see, mida sa päriselt näed. Kirjuta üles: 5 erinevat kategooria väärtust.
SELECT
  COUNT(DISTINCT category)                  AS algseid_kategooriaid,
  COUNT(DISTINCT lower(trim(category)))     AS uhtlustatud_kategooriaid
FROM products_test;

SELECT subcategory, COUNT(*)
FROM products_test
GROUP BY subcategory
ORDER BY subcategory;

